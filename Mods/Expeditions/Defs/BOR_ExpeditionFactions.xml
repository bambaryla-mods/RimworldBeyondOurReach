<?xml version="1.0" encoding="utf-8"?>
<!-- What BOR's factions change about Expeditions' own sites. Each override waits for its tier, so tier goods never
     reach a colony below it. -->
<Defs>

	<!-- As a patron, the Solar Republic pays in its own goods instead of silver. -->
	<Expeditions.ExpeditionFactionDef>
		<defName>BOR_ExpFaction_SolarRepublic</defName>
		<faction>BOR_SolarRepublic</faction>
		<gates>
			<li Class="Expeditions.SiteGate_Research"><research><li>BOR_Research_Analyzer_I</li></research></li>
		</gates>
		<payment>
			<li>BOR_Sunsteel</li>
			<li>BOR_Sunweave</li>
			<li>BOR_FuelRod</li>
		</payment>
	</Expeditions.ExpeditionFactionDef>

	<!-- The Badzaari hold their own gear, and the Kwazaari pay scrip for every badzaar gun brought home from a
	     bounty on them. The squad keeps the guns: sell them, or use them. -->
	<Expeditions.ExpeditionFactionDef>
		<defName>BOR_ExpFaction_Badzaari</defName>
		<faction>BOR_BadzaarHazaard</faction>
		<gates>
			<li Class="Expeditions.SiteGate_Research"><research><li>BOR_Research_Analyzer_II</li></research></li>
		</gates>
		<siteLoot>
			<li>
				<site>Exp_HostileOutpost</site>
				<loot>
					<li><thing>BOR_Gun_Badzaar_Rifle</thing><count>1</count><chance>0.5</chance></li>
					<li><thing>BOR_Gun_Badzaar_Pistol</thing><count>1</count><chance>0.4</chance></li>
					<li><thing>BOR_Gun_Badzaar_Shotgun</thing><count>1</count><chance>0.3</chance></li>
					<li><thing>BOR_QuasarAlloy</thing><count>10~30</count></li>
					<li><thing>BOR_ComponentII</thing><count>1~3</count><chance>0.5</chance></li>
				</loot>
			</li>
			<li>
				<site>Exp_SlaverConvoy</site>
				<loot>
					<li><thing>BOR_Gun_Badzaar_Rifle</thing><count>1</count><chance>0.5</chance></li>
				</loot>
			</li>
			<li>
				<site>Exp_SettlementBounty</site>
				<loot>
					<li><thing>BOR_Gun_Badzaar_Rifle</thing><count>1~2</count></li>
					<li><thing>BOR_Gun_Badzaar_Pistol</thing><count>1</count><chance>0.5</chance></li>
					<li><thing>BOR_Gun_Badzaar_LMG</thing><count>1</count><chance>0.25</chance></li>
					<li><thing>BOR_Gun_Badzaar_Sniper</thing><count>1</count><chance>0.25</chance></li>
				</loot>
			</li>
		</siteLoot>
		<outcomeEffects>
			<li>
				<site>Exp_SettlementBounty</site>
				<effects>
					<li Class="BeyondOurReach.OutcomeEffect_Scrip">
						<perThing>
							<li><thing>BOR_Gun_Badzaar_Rifle</thing><scrip>3</scrip></li>
							<li><thing>BOR_Gun_Badzaar_Pistol</thing><scrip>3</scrip></li>
							<li><thing>BOR_Gun_Badzaar_Shotgun</thing><scrip>3</scrip></li>
							<li><thing>BOR_Gun_Badzaar_LMG</thing><scrip>3</scrip></li>
							<li><thing>BOR_Gun_Badzaar_Sniper</thing><scrip>3</scrip></li>
						</perThing>
					</li>
				</effects>
			</li>
		</outcomeEffects>
	</Expeditions.ExpeditionFactionDef>

	<!-- The Vanquishers' outposts hold tenebrite. On the Path of Light it burns before it comes home. -->
	<Expeditions.ExpeditionFactionDef>
		<defName>BOR_ExpFaction_Vanquishers</defName>
		<faction>BOR_Tenebrites</faction>
		<gates>
			<li Class="Expeditions.SiteGate_Research"><research><li>BOR_Research_Analyzer_III</li></research></li>
		</gates>
		<siteLoot>
			<li>
				<site>Exp_HostileOutpost</site>
				<loot>
					<li><thing>BOR_Tenebrite</thing><count>5~15</count></li>
					<li><thing>BOR_ComponentIII</thing><count>1~2</count><chance>0.4</chance></li>
				</loot>
			</li>
		</siteLoot>
	</Expeditions.ExpeditionFactionDef>

</Defs>
