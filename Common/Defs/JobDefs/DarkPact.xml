<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- A colonist communes with the dark mirror to bargain for a tenebral research; see openspec/specs/dark-pacts -->
  <JobDef>
    <defName>BOR_DarkMirrorPact</defName>
    <driverClass>BeyondOurReach.JobDriver_DarkMirrorPact</driverClass>
    <reportString>communing with the dark mirror.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- An Umbral communes with the dark mirror for its next transformation group -->
  <JobDef>
    <defName>BOR_DarkMirrorUmbralPact</defName>
    <driverClass>BeyondOurReach.JobDriver_DarkMirrorUmbralPact</driverClass>
    <reportString>communing with the dark mirror.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
</Defs>
