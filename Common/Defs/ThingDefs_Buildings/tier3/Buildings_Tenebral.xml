<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- The dark archotech altar. The tenebral pod is part of the dark mirror (Buildings_Research.xml). -->
	<ThingDef ParentName="BuildingBase">
		<defName>BOR_DarkArchotechAltar_III</defName>
		<label>dark archotech altar</label>
		<description>A forge that already knows every tenebral design but will not give them up for free. Each design must be unsealed by work, once for all altars, and every item has to be paid for in crystalline joints. Only the psychotic can bear to work it, and the work drains their bloodlust. Work left unfinished is kept.</description>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>BOR/Things/Building/tier3/dark_altar</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawRotated>false</drawRotated>
			<drawSize>(4.5, 4.5)</drawSize>
			<drawOffset>(0,4,0.25)</drawOffset>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<constructEffect>ConstructMetal</constructEffect>
		<costList>
			<BOR_Tenebrite>200</BOR_Tenebrite>
			<BOR_ComponentIII>6</BOR_ComponentIII>
		</costList>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.4</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<WorkToBuild>9000</WorkToBuild>
			<MaxHitPoints>1000</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<size>(3,3)</size>
		<designationCategory>BOR</designationCategory>
		<uiOrder>2320</uiOrder>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<inspectorTabs>
			<li>BeyondOurReach.ITab_DarkAltar</li>
		</inspectorTabs>
		<comps>
			<li Class="BeyondOurReach.CompProperties_DarkAltar">
				<gridWidth>6</gridWidth>
				<unlockWorkFactor>1</unlockWorkFactor>
				<produceWorkFactor>1.5</produceWorkFactor>
				<componentCostFactor>0.5</componentCostFactor>
				<bloodlustDrainPerDay>2</bloodlustDrainPerDay>
				<entries>
					<li><thing>BOR_Gun_Autopistol_TIII</thing></li>
					<li><thing>BOR_Gun_ChainShotgun_TIII</thing></li>
					<li><thing>BOR_Gun_AssaultRifle_TIII</thing></li>
					<li><thing>BOR_Gun_SniperRifle_TIII</thing></li>
					<li><thing>BOR_Gun_LMG_TIII</thing></li>
					<li><thing>BOR_Tenebrite</thing></li>
					<li><thing>BOR_TenebralOrgan</thing></li>
					<li><thing>BOR_TenebralAppendage</thing></li>
					<li><thing>BOR_Femtoclusters</thing></li>
					<li><thing>BOR_Tenebral_Apparel_PowerArmor</thing></li>
					<li><thing>BOR_Tenebral_Apparel_PowerArmorHelmet</thing></li>
					<li><thing>BOR_Tenebral_Carbonsuit</thing></li>
					<li><thing>BOR_Tenebral_Apparel_Backpack</thing></li>
					<li><thing>BOR_Tenebral_Apparel_ShieldBelt</thing></li>
				</entries>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>BOR_Research_Production_III</li>
		</researchPrerequisites>
		<rotatable>true</rotatable>
		<modExtensions>
		  <li Class="BeyondOurReach.BorUIScheme"><scheme>BOR_UIScheme_Tenebral</scheme></li>
			<li Class="BeyondOurReach.DefModExtension_TenebralBuilding" />
		</modExtensions>
	</ThingDef>

</Defs>
